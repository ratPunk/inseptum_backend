# --- Claude / ClaudeHub ---
# Сюда вставляется реальный API-ключ. Никогда не коммитить .env.
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.claudehub.fun
CLAUDE_MODEL=claude-haiku-4-5

# --- AI audit / cache ---
AI_DAILY_BUDGET_USD=2.00
AI_PROMPT_VERSION=v1

# --- Соль для хеширования IP в audit log (придумайте свою длинную строку) ---
AI_IP_SALT=change_me_to_random_long_string
